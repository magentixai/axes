{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magentixai/axes/schema/requirement-profile.schema.json",
  "title": "AXES requirement profile (WO19 section 3, A1)",
  "description": "A relying party's declared, versioned requirements. Identity: requirement_profile_id; digest: SHA-256 of the RFC 8785 bytes (not stored inside). docs/07.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_profile_id",
    "requirement_profile_version",
    "profile_purpose_type",
    "publisher_id",
    "relying_party_roles",
    "subject_types",
    "effective_from",
    "unsettled_question_notes",
    "requirements"
  ],
  "properties": {
    "requirement_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_]+@[0-9A-Za-z.]+$"
    },
    "requirement_profile_version": {
      "type": "string"
    },
    "profile_purpose_type": {
      "enum": [
        "sufficiency",
        "disclosure"
      ]
    },
    "publisher_id": {
      "type": "string"
    },
    "relying_party_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "subject_types": {
      "type": "array",
      "items": {
        "enum": [
          "envelope",
          "bundle",
          "stream_window",
          "release"
        ]
      },
      "minItems": 1
    },
    "extended_profile_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_]+@[0-9A-Za-z.]+$"
      }
    },
    "effective_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,}Z$"
    },
    "effective_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,}Z$"
    },
    "unsettled_question_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vector_set_ref": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "check_type",
        "subject_type",
        "obligation_type",
        "floor_indicator",
        "rationale_note",
        "source_refs"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
        },
        "check_type": {
          "enum": [
            "field_presence",
            "chain_integrity",
            "sequence_continuity",
            "anchoring",
            "settlement_commitment"
          ]
        },
        "subject_type": {
          "enum": [
            "envelope",
            "bundle",
            "stream_window",
            "release"
          ]
        },
        "field_path": {
          "type": "string",
          "pattern": "^(/[^/]*)+$"
        },
        "obligation_type": {
          "enum": [
            "required",
            "conditional",
            "optional",
            "prohibited"
          ]
        },
        "condition_expression": {
          "type": "string",
          "minLength": 1
        },
        "accepted_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "minimum_value": {
          "type": "string"
        },
        "value_ladder_ref": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_]+@[0-9A-Za-z.]+$"
        },
        "required_basis_status": {
          "enum": [
            "demonstrated",
            "stubbed",
            "simulated"
          ]
        },
        "anchoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_independent_anchor_count": {
              "type": "integer",
              "minimum": 1
            },
            "accepted_anchoring_methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maximum_anchoring_lag": {
              "type": "string",
              "pattern": "^P"
            }
          }
        },
        "floor_indicator": {
          "type": "boolean"
        },
        "rationale_note": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "obligation_type": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "required": [
              "condition_expression"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "check_type": {
                "enum": [
                  "field_presence",
                  "anchoring",
                  "settlement_commitment"
                ]
              }
            }
          },
          "then": {
            "required": [
              "field_path"
            ]
          }
        },
        {
          "if": {
            "required": [
              "minimum_value"
            ]
          },
          "then": {
            "required": [
              "value_ladder_ref"
            ]
          }
        }
      ]
    }
  }
}
