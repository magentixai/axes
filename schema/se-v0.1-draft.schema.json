{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbitr.magentix.ai/schemas/se-v1-draft.schema.json",
  "title": "ARBITR Secure Execution Envelope SE v1 Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "envelope_id",
    "org_id",
    "tenant_id",
    "environment_id",
    "trace_id",
    "span_id",
    "event_kind",
    "occurred_at",
    "emitted_at",
    "idempotency_key",
    "authority_scope",
    "result_status",
    "data_classification"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "se.v1.draft"
    },
    "envelope_id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "span_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_span_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "trace.started",
        "trace.completed",
        "agent.started",
        "agent.completed",
        "tool_call.requested",
        "tool_call.completed",
        "external_commit.attempted",
        "external_commit.completed",
        "checkpoint.created",
        "handoff.created",
        "error.reported"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "authority_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "delegation_receipt_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_ref": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_ref": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "target_system": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "target_resource_type": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "target_resource_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "result_status": {
      "type": "string",
      "enum": [
        "OK",
        "ERROR",
        "PARTIAL",
        "TIMEOUT"
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "inputs_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/runtime"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/authority_context"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/target"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_artifact"
      },
      "default": []
    },
    "semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/semantics"
        },
        {
          "type": "null"
        }
      ]
    },
    "cross_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/cross_scope"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "default": {}
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "redaction_status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "RAW_NOT_STORED",
                "REDACTED",
                "HASH_ONLY",
                "UNKNOWN"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "uri",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_type": {
          "type": "string",
          "maxLength": 128
        },
        "uri": {
          "type": "string",
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "framework_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_instance_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authority_context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scope": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "delegated_by_ref": {
          "type": "string"
        },
        "delegated_to_ref": {
          "type": "string"
        },
        "delegation_receipt_id": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "constraints": {
          "type": "object"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "system": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "resource_label": {
          "type": "string"
        },
        "external_correlation_id": {
          "type": "string"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cross_scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "boundary_type": {
          "type": "string",
          "enum": [
            "ENV_EXIT",
            "TENANT_EXIT",
            "SYSTEM_EXIT"
          ]
        },
        "display_label": {
          "type": "string"
        },
        "continuation_ref": {
          "type": "object"
        }
      }
    }
  }
}